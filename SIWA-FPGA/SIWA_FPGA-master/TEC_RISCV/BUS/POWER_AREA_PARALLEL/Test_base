`timescale 1ns / 1ps
`default_nettype none
`define ALL_BDSCT 0
`define PCKG_SZ _pckgsz_ 
`define BROADCAST {8{1'b1}}
`define DRVRS _drvrs_ 
`define BITS _pckgsz_ 
`define MAX_MSGS 1024
`include "../../Library.sv"
//`include "../Library.sv"

module Simulacion;
 //inputs
  reg clk;
  reg reset;
  reg pndng[`BITS-1:0][`DRVRS-1:0];
  reg [`PCKG_SZ-1:0] D_pop[`BITS-1:0][`DRVRS-1:0];
 //outputs
  wire push[`BITS-1:0][`DRVRS-1:0];
  wire pop[`BITS-1:0][`DRVRS-1:0];
  wire [`PCKG_SZ-1:0] D_push[`BITS-1:0][`DRVRS-1:0];

 prll_bs_gnrtr_n_rbtr #(.buses(`BITS),.drvrs(`DRVRS),.bits(`PCKG_SZ),.broadcast(`BROADCAST)) uut(
  .clk(clk),
  .reset(reset),
  .pndng(pndng),
  .push(push),
  .pop(pop),
  .D_pop(D_pop),
  .D_push(D_push)
);

 //varibles used for testing
  reg [7:0] target [`DRVRS-1:0];
  reg [7:0] source [`DRVRS-1:0];
  int i = 0;
  int k = 0;
  int mensages_enviados = 0;
  reg [15:0] counter[`BITS-1:0][`DRVRS-1:0];
  reg [`PCKG_SZ-33:0]data_to_send[`BITS-1:0][`DRVRS-1:0];
  reg [7:0] broadcast;

////////////////////////////////////////////////
// Initial block
////////////////////////////////////////////////

initial begin
$dumpfile("vcd_file.vcd");
$dumpvars(0,Simulacion);
//$vcdplusfile ("vcd_file.vpd");
//$vcdpluson;
  clk=0;
  reset =1;
  broadcast = `BROADCAST;
  for(i=0;i<`DRVRS;i=i+1)
  begin
    target[i] = i;
    source[i] = i;
  end
    for(k=0;k <`BITS;k=k+1)begin
      for(i=0;i<`DRVRS;i=i+1)begin
        counter[k][i] = 0; 
        data_to_send[k][i] = {((`PCKG_SZ-32)/2){2'b01}};
      end
    end
end

  always #1 clk=~clk;   
  always @(posedge clk)begin
    prueba();
  end
  
////////////////////////////////////////////////
// test definition block
////////////////////////////////////////////////
  task prueba ();
    reset = 0;
    for(k=0;k <`BITS;k=k+1)begin
      for(i=0;i<`DRVRS;i=i+1)begin
        pndng[k][i] = {1'b1};
        if(`ALL_BDSCT == 0)begin
          if(i != `DRVRS-1)begin
            D_pop[k][i]={target[i+1],source[i],counter[k][i],data_to_send[k][i]};
          end else begin
            D_pop[k][i]={target[0],source[i],counter[k][i],data_to_send[k][i]};
          end
        end else begin
          D_pop[k][i]={broadcast,source[i],counter[k][i],data_to_send[k][i]};
        end
      end
    end

    for(k=0;k<`BITS;k=k+1)begin
        for(i=0;i<`DRVRS;i=i+1)
        begin
          if( push[k][i] == 1 )begin
            $display("At time %t: in terminal %g bus %g message saved. target: %g source: %g ID: %g",$time/2,i,k, D_push[k][i][`PCKG_SZ-1:`PCKG_SZ-8], D_push[k][i][`PCKG_SZ-9:`PCKG_SZ-16],D_push[k][i][`PCKG_SZ-17:`PCKG_SZ-32]);
            mensages_enviados=mensages_enviados+1; 
          end
        end
    end

    for(k=0;k<`BITS;k=k+1)begin
        for(i=0;i<`DRVRS;i=i+1)
        begin
          if( pop[k][i] == 1 )begin
            $display("At time %t: in terminal %g bus %g message pop. target: %g source: %g ID: %g",$time/2,i,k, D_pop[k][i][`PCKG_SZ-1:`PCKG_SZ-8], D_pop[k][i][`PCKG_SZ-9:`PCKG_SZ-16],D_pop[k][i][`PCKG_SZ-17:`PCKG_SZ-32]);
            counter[k][i] = counter[k][i]+1;
            data_to_send[k][i]=~data_to_send[k][i];
          end        
        end
    end
 
  if(mensages_enviados >= `MAX_MSGS)begin
    $display("mensages_enviados= %g",mensages_enviados);
    $finish;
//    $vcdplusclose;
  end

  endtask

endmodule
